# ==============================================================================
# MedicineApp Mobile — Environment Configuration (.env)
# ==============================================================================
# Instructions:
#   1. Copy this file to create your active environment file:
#      cp .env.example .env
#   2. Choose the appropriate API_BASE_URL below for your development target.
#   3. Note: After changing .env, perform a hot restart (R) or rebuild the app.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY BACKEND API URL (Node.js API Gateway)
# ------------------------------------------------------------------------------

# [Option A] Android Emulator (AVD) — Local Stack (dev.sh / Port 3001) [DEFAULT]
# 10.0.2.2 is the special alias mapped to 127.0.0.1 of the development host PC.
API_BASE_URL=http://10.0.2.2:3001/api

# [Option B] Android Emulator (AVD) — Docker Compose Stack (Port 3000)
# API_BASE_URL=http://10.0.2.2:3000/api

# [Option C] Physical Android Device via USB (Recommended Development Mode)
# Requires running ADB reverse port forwarding beforehand:
#   adb reverse tcp:3001 tcp:3001
# Then the device accesses the host server via localhost:
# API_BASE_URL=http://127.0.0.1:3001/api

# [Option D] Physical Android Device via Local Wi-Fi (LAN)
# Replace 192.168.1.x with your host computer's local network IP address:
#   Linux/macOS: hostname -I  or  ip route get 1
#   Windows:     ipconfig
# Ensure both devices are on the same Wi-Fi subnet and firewall permits port 3001.
# API_BASE_URL=http://192.168.1.50:3001/api

# [Option E] Linux Desktop / Web Development
# API_BASE_URL=http://127.0.0.1:3001/api

# [Option F] Production / Remote Server
# API_BASE_URL=https://api.medicineapp.example.com/api

# ------------------------------------------------------------------------------
# 2. OPTIONAL COMPILATION DEFINES (--dart-define) REFERENCE
# ------------------------------------------------------------------------------
# These flags are passed during 'flutter run' or 'flutter build' (not in .env):
#
# Enable immediate test notification burst on boot:
#   flutter run --dart-define=SEND_DEBUG_NOTIFS=true
#
# Clear stored credentials/tokens on startup (useful for automated UI testing):
#   flutter run --dart-define=QA_RESET_SESSION_ON_BOOT=true
#
# Automated QA test credentials (for integration_test/qa_smoke_test.dart):
#   flutter test integration_test/qa_smoke_test.dart \
#     --dart-define=QA_EMPTY_EMAIL=qa.empty@medicineapp.local \
#     --dart-define=QA_EMPTY_PASSWORD=TestPassword123! \
#     --dart-define=QA_FULL_EMAIL=qa.full@medicineapp.local \
#     --dart-define=QA_FULL_PASSWORD=TestPassword123!
# ------------------------------------------------------------------------------
